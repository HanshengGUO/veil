{
  "name": "veil",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Quant-native agent harness: explore freely, verify before you claim",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "bench/runner"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm run test && npm run engine:runtime:smoke && npm run csv-pit:verify && npm run parquet-pit:verify && npm run bench:smoke && npm run golden-path:verify",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bench:calibrate": "tsx bench/fixtures/calibrate.ts",
    "bench:calibrate:honest": "tsx bench/fixtures/honest-calibrate.ts",
    "bench:tasks:verify": "tsx bench/runner/src/verify-cli.ts --suite full",
    "bench:smoke": "tsx bench/runner/src/verify-cli.ts --suite smoke",
    "bench:models": "tsx bench/runner/src/models-cli.ts",
    "bench:run": "tsx bench/runner/src/run-cli.ts",
    "bench:baseline": "tsx bench/runner/src/baseline-cli.ts",
    "bench:baseline:rescore": "tsx bench/runner/src/rescore-cli.ts",
    "engine:runtime:smoke": "tsx packages/veil-engine/src/runtime-smoke-cli.ts",
    "csv-pit:verify": "tsx examples/csv-pit/run.ts",
    "parquet-pit:verify": "tsx examples/parquet-pit/run.ts",
    "golden-path": "tsx examples/golden-path/run.ts",
    "golden-path:verify": "tsx examples/golden-path/run.ts --verify"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "26.1.2",
    "tsx": "4.23.9",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
