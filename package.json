{
  "name": "veil",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first harness for AI-assisted quant research: explore freely, verify rigorously, deliver better work",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "bench/runner"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "check": "npm run lockfile:verify && npm run lint && npm run typecheck && npm run test && npm run engine:runtime:smoke && npm run csv-pit:verify && npm run parquet-pit:verify && npm run multi-file-pit:verify && npm run read-set:verify && npm run snapshot-recovery:verify && npm run veil-data:verify && npm run artifact:verify && npm run artifact-execution:verify && npm run walk-forward:verify && npm run walk-forward-contract:verify && npm run bench:stage3:verify && npm run stage4-plugin:verify && npm run stage4-claim:verify && npm run bench:stage4:verify && npm run release:verify && npm run bench:smoke && npm run golden-path:verify",
    "lockfile:verify": "node scripts/verify-lockfile-sources.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "release:verify": "tsx scripts/verify-release.ts",
    "release:install-smoke": "tsx scripts/packed-install-smoke.ts",
    "bench:calibrate": "tsx bench/fixtures/calibrate.ts",
    "bench:calibrate:honest": "tsx bench/fixtures/honest-calibrate.ts",
    "bench:tasks:verify": "tsx bench/runner/src/verify-cli.ts --suite full",
    "bench:stage2:verify": "tsx bench/runner/src/stage2-acceptance-cli.ts",
    "bench:stage3:verify": "tsx bench/runner/src/stage3-acceptance-cli.ts",
    "bench:stage4:verify": "tsx bench/runner/src/stage4-acceptance-cli.ts",
    "bench:smoke": "tsx bench/runner/src/verify-cli.ts --suite smoke",
    "bench:models": "tsx bench/runner/src/models-cli.ts",
    "bench:run": "tsx bench/runner/src/run-cli.ts",
    "bench:baseline": "tsx bench/runner/src/baseline-cli.ts",
    "bench:evaluate": "tsx bench/runner/src/baseline-cli.ts",
    "bench:baseline:rescore": "tsx bench/runner/src/rescore-cli.ts",
    "engine:runtime:smoke": "tsx packages/veil-engine/src/runtime-smoke-cli.ts",
    "csv-pit:verify": "tsx examples/csv-pit/run.ts",
    "parquet-pit:verify": "tsx examples/parquet-pit/run.ts",
    "multi-file-pit:verify": "tsx examples/multi-file-pit/run.ts",
    "read-set:verify": "tsx examples/read-set/run.ts",
    "snapshot-recovery:verify": "tsx examples/snapshot-recovery/run.ts",
    "veil-data:verify": "tsx examples/veil-data/run.ts",
    "data:inspect": "tsx examples/own-data/inspect-cli.ts",
    "artifact:verify": "tsx examples/artifact-identity/run.ts",
    "artifact-execution:verify": "tsx examples/artifact-execution/run.ts",
    "walk-forward:verify": "tsx examples/walk-forward-windows/run.ts",
    "walk-forward-contract:verify": "tsx examples/walk-forward-contract/run.ts",
    "agent-loop:verify": "tsx examples/agent-loop/run.ts",
    "stage4-claim:verify": "tsx examples/stage4-claim/run.ts",
    "stage4-agent:verify": "tsx examples/stage4-agent-loop/run.ts",
    "stage4-plugin:verify": "tsx examples/stage4-plugin/run.ts",
    "golden-path": "tsx examples/golden-path/run.ts",
    "golden-path:evidence:verify": "tsx examples/golden-path/run.ts --evidence-only",
    "golden-path:verify": "tsx examples/golden-path/run.ts --verify"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "26.1.2",
    "tsx": "4.23.9",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
